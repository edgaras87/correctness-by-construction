# ======================================================================
# Hygiene Base — any repo, from day zero (records-only repos included)
# ======================================================================

# JetBrains IDE state — machine-local, never project truth
.idea/
*.iml

# OS scratch files
.DS_Store
Thumbs.db

# Logs
*.log

# Local secrets — .env.example is the committed counterpart; real values
# never enter history
.env

# Claude Code machine-local settings — permissions and local overrides;
# its committed counterpart, when a project adds one, is .claude/settings.json
.claude/settings.local.json

# The reviewer's standing instructions — one person, one checkout;
# the tool loads it beside CLAUDE.md but never ignores it on its own
CLAUDE.local.md

# ======================================================================
# Stack Overlays — appended below this line when the repo first builds on its stack
# ======================================================================
